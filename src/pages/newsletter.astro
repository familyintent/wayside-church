---
import BaseLayout from "../layouts/BaseLayout.astro";
import SmsOptIn from "../components/SmsOptIn.astro";
import { site } from "../lib/content";
---

<BaseLayout
  title="Wayside Church Newsletter and Text Updates"
  description="Join Wayside Church text updates with clear SMS consent, frequency, rates, STOP, HELP, Privacy Policy, and Terms links."
  robots="noindex, follow"
>
  <section class="page-hero page-hero--center">
    <div class="shell page-hero__inner">
      <p class="eyebrow">Stay connected</p>
      <h1>{site.newsletterPage.title}</h1>
      <p>Join Wayside Church text updates using the same clear consent process shown on our dedicated Text Updates page.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell shell--narrow">
      <SmsOptIn />
    </div>
  </section>
</BaseLayout>
