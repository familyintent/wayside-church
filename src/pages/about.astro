---
import BaseLayout from "../layouts/BaseLayout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { site } from "../lib/content";
import { imageSize, imageSizesFor, imageSrcset } from "../lib/images";
import { withBase } from "../lib/paths";
import { getLeaderId, getLeaderPersonSchemas } from "../lib/schema";

const aboutHero = site.about.hero;
const aboutHistory = site.about.history;
const aboutSchemas = getLeaderPersonSchemas(site.about.leaders);
const aboutHeroImageSize = imageSize(aboutHero.image);
const aboutHeroImageSrcset = imageSrcset(aboutHero.image);
const aboutHistoryArchiveImages = aboutHistory.archiveImages.map((image) => ({
  ...image,
  size: imageSize(image.image),
}));
const leaders = site.about.leaders.map((leader) => ({
  ...leader,
  id: getLeaderId(leader),
  imageSize: imageSize(leader.image),
  imageSrcset: imageSrcset(leader.image),
}));
---

<BaseLayout title="About Wayside Church in Charlton, MA" description="Learn Wayside Church's Gospel-centered mission, historic Charlton roots, beliefs, and leaders serving this local church family." image={aboutHero.image} imageAlt={aboutHero.imageAlt} extraSchemas={aboutSchemas}>
  <section class="about-hero" aria-labelledby="about-title">
    <div class="shell about-hero__grid">
      <div class="about-hero__copy">
        <p class="eyebrow">{aboutHero.eyebrow}</p>
        <h1 id="about-title">{site.about.title}</h1>
        <p>{site.about.intro}</p>
        <div class="button-row">
          <ButtonLink href="/plan-a-visit/">Plan a Visit</ButtonLink>
          <ButtonLink href="/ministries/" variant="secondary">Explore Ministries</ButtonLink>
        </div>
      </div>

      <div class="about-hero__media">
        <figure class="about-hero__image-frame">
          <img src={withBase(aboutHero.image)} srcset={aboutHeroImageSrcset} sizes={imageSizesFor("panel")} alt={aboutHero.imageAlt} width={aboutHeroImageSize?.width} height={aboutHeroImageSize?.height} loading="eager" decoding="async" />
          <figcaption>{aboutHero.caption}</figcaption>
        </figure>
        <div class="about-hero__cards" aria-label="Sunday gathering times">
          {aboutHero.cards.map((card) => (
            <div>
              <span>{card.label}</span>
              <strong>{card.value}</strong>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section about-story">
    <div class="shell about-story__grid">
      <div>
        <SectionIntro eyebrow="Our center" title={site.about.gospel.title}>
          <p>{site.about.gospel.body}</p>
        </SectionIntro>
        <div class="mission-quote">
          <p>{site.church.mission}</p>
        </div>
      </div>

      <div class="about-markers" aria-label="What shapes Wayside Church">
        {site.about.markers.map((marker, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h2>{marker.title}</h2>
            <p>{marker.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-history">
    <div class="shell about-history__intro">
      <SectionIntro eyebrow={aboutHistory.eyebrow} title={aboutHistory.title}>
        <p>{aboutHistory.intro}</p>
      </SectionIntro>
    </div>

    <div class="shell history-experience">
      <div class="history-timeline" data-history-timeline>
        <div class="history-timeline__header">
          <div>
            <p class="eyebrow">Timeline</p>
            <h3>Follow the story decade by decade.</h3>
          </div>
          <div class="history-timeline__progress" aria-hidden="true">
            <span></span>
          </div>
        </div>

        <div class="history-timeline__tabs" role="tablist" aria-label="Wayside Church history eras">
          {aboutHistory.timeline.map((item, index) => (
            <button id={`history-tab-${index}`} class="history-era-tab" type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`history-panel-${index}`} tabindex={index === 0 ? "0" : "-1"}>
              <span>{item.year}</span>
              <strong>{item.title}</strong>
            </button>
          ))}
        </div>

        <div class="history-timeline__panels">
          {aboutHistory.timeline.map((item, index) => (
            <article id={`history-panel-${index}`} class="history-panel" role="tabpanel" aria-labelledby={`history-tab-${index}`} tabindex="0">
              <time>{item.year}</time>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>

        <aside class="history-note" aria-label="Heritage note">
          <p class="eyebrow">Heritage note</p>
          <h3>{aboutHistory.noteTitle}</h3>
          <p>{aboutHistory.noteBody}</p>
        </aside>
      </div>

      <aside class="history-archive" aria-label="Wayside Church archival photos">
        {aboutHistoryArchiveImages[0] && (
          <figure class="history-archive__primary">
            <img src={withBase(aboutHistoryArchiveImages[0].image)} alt={aboutHistoryArchiveImages[0].alt} width={aboutHistoryArchiveImages[0].size?.width} height={aboutHistoryArchiveImages[0].size?.height} loading="lazy" decoding="async" />
            <figcaption>
              <span>{aboutHistoryArchiveImages[0].label}</span>
              <p>{aboutHistoryArchiveImages[0].caption}</p>
            </figcaption>
          </figure>
        )}

        <div class="history-archive__stack">
          {aboutHistoryArchiveImages.slice(1).map((image) => (
            <figure>
              <img src={withBase(image.image)} alt={image.alt} width={image.size?.width} height={image.size?.height} loading="lazy" decoding="async" />
              <figcaption>
                <span>{image.label}</span>
                <p>{image.caption}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section about-fivefold">
    <div class="shell">
      <SectionIntro eyebrow="The ministry of Jesus" title={site.about.fiveFold.title}>
        <p>{site.about.fiveFold.body}</p>
      </SectionIntro>

      <div class="fivefold-list">
        {site.about.fiveFold.items.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="shell">
      <SectionIntro eyebrow="Our leaders" title="Meet Chase and Owen">
        <p>{site.about.leadersIntro}</p>
      </SectionIntro>
      <div class="leader-grid leader-grid--feature">
        {leaders.map((leader) => (
          <article class="leader-card leader-card--feature" id={leader.id}>
            <img src={withBase(leader.image)} srcset={leader.imageSrcset} sizes={imageSizesFor("leader")} alt={leader.name} width={leader.imageSize?.width} height={leader.imageSize?.height} loading="lazy" decoding="async" />
            <div class="leader-card__body">
              <p class="eyebrow">{leader.role}</p>
              <h3>{leader.name}</h3>
              <p>{leader.bio}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="section-action">
        <ButtonLink href="/leadership/" variant="secondary">Leadership Page</ButtonLink>
      </div>
    </div>
  </section>

  <section class="section about-faith">
    <div class="shell about-faith__grid">
      <div>
        <p class="eyebrow">Statement of faith</p>
        <h2>Our statement of faith</h2>
        <p>{site.about.faithIntro}</p>
        <p>{site.about.gatheringNote}</p>
        <ButtonLink href="/beliefs/" variant="text">Read More About Our Beliefs</ButtonLink>
      </div>

      <div class="belief-accordion">
        {site.about.beliefs.map((belief, index) => (
          <details class="belief-item" open={index === 0}>
            <summary>
              <span>{belief.title}</span>
            </summary>
            <p>{belief.body}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>("[data-history-timeline]").forEach((timeline) => {
      const tabs = Array.from(timeline.querySelectorAll<HTMLButtonElement>("[role='tab']"));
      const panels = Array.from(timeline.querySelectorAll<HTMLElement>("[role='tabpanel']"));

      if (!tabs.length || !panels.length) return;

      timeline.classList.add("history-timeline--enhanced");

      const selectTab = (index: number, shouldFocus = false) => {
        const safeIndex = Math.max(0, Math.min(index, tabs.length - 1));

        tabs.forEach((tab, tabIndex) => {
          const isSelected = tabIndex === safeIndex;
          tab.setAttribute("aria-selected", String(isSelected));
          tab.tabIndex = isSelected ? 0 : -1;
        });

        panels.forEach((panel, panelIndex) => {
          panel.hidden = panelIndex !== safeIndex;
        });

        const progress = tabs.length > 1 ? (safeIndex / (tabs.length - 1)) * 100 : 100;
        timeline.style.setProperty("--history-progress", `${progress}%`);

        if (shouldFocus) {
          tabs[safeIndex]?.focus();
        }

        tabs[safeIndex]?.scrollIntoView({ block: "nearest", inline: "nearest" });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => selectTab(index));
        tab.addEventListener("keydown", (event) => {
          const currentIndex = tabs.indexOf(document.activeElement as HTMLButtonElement);
          let nextIndex = currentIndex;

          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            nextIndex = (currentIndex + 1) % tabs.length;
          } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
          } else if (event.key === "Home") {
            nextIndex = 0;
          } else if (event.key === "End") {
            nextIndex = tabs.length - 1;
          } else if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            selectTab(index);
            return;
          } else {
            return;
          }

          event.preventDefault();
          selectTab(nextIndex, true);
        });
      });

      selectTab(0);
    });
  </script>

  <section class="visit-band">
    <div class="shell visit-band__inner">
      <div>
        <p class="eyebrow">Come visit us</p>
        <h2>{site.service.primary.day}s at {site.service.primary.time}</h2>
        <p>{site.contact.addressLine1}, {site.contact.cityStateZip}</p>
      </div>
      <ButtonLink href="/plan-a-visit/">Plan a Visit</ButtonLink>
    </div>
  </section>
</BaseLayout>
